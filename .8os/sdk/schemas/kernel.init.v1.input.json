{
  "$id": "kernel.init.v1.input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kernel_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "primary_operator_id": {
      "minLength": 1,
      "type": "string"
    },
    "primary_scope_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "project_name": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "project_name",
    "primary_scope_id",
    "primary_operator_id",
    "kernel_version"
  ],
  "title": "kernel.init input",
  "type": "object"
}
