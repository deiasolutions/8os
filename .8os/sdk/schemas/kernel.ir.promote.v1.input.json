{
  "$id": "kernel.ir.promote.v1.input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authored_by": {
      "type": "string"
    },
    "authority_level": {
      "enum": [
        "hard",
        "convention",
        "uncalibrated"
      ]
    },
    "event_id": {
      "type": "string"
    },
    "target_scope": {
      "type": "string"
    },
    "target_slug": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "to_tier": {
      "enum": [
        1,
        2
      ]
    }
  },
  "required": [
    "event_id",
    "to_tier",
    "target_scope",
    "target_slug",
    "authored_by",
    "authority_level"
  ],
  "type": "object"
}
