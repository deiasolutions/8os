{
  "$id": "kernel.ir.deps.v1.input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "direction": {
      "default": "forward",
      "enum": [
        "forward",
        "reverse",
        "both"
      ]
    },
    "ir_id": {
      "type": "string"
    },
    "max_depth": {
      "default": 5,
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "tier_filter": {
      "default": null,
      "items": {
        "enum": [
          1,
          2,
          3
        ]
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "ir_id"
  ],
  "type": "object"
}
