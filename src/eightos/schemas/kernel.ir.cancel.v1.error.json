{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel.ir.cancel.v1.error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "op", "status", "code", "message", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "op": { "const": "kernel.ir.cancel" },
    "status": { "const": "error" },
    "code": {
      "enum": [
        "SCHEMA_INVALID",
        "NOT_FOUND",
        "IR_ALREADY_CANCELLED",
        "IR_NOT_CANCELLABLE",
        "CANCELLATION_AUTHORITY_INSUFFICIENT"
      ]
    },
    "message": { "type": "string" },
    "context": { "type": "object" }
  }
}
