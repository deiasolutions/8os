{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel.ir.resolve.v1.input",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_id", "resolver_id", "resolution_text", "cost_actual"],
  "properties": {
    "ir_id": { "type": "string" },
    "resolver_id": { "type": "string" },
    "resolution_text": { "type": "string", "minLength": 1 },
    "cost_actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_ms", "coin_usd", "carbon_g"],
      "properties": {
        "clock_ms": { "type": "number" },
        "coin_usd": { "type": "number" },
        "carbon_g": { "type": "number" },
        "model_name": { "type": ["string", "null"] },
        "tokens_in": { "type": ["integer", "null"] },
        "tokens_out": { "type": ["integer", "null"] }
      }
    },
    "bridge_id": { "type": ["string", "null"] },
    "authorization_id": { "type": ["string", "null"] },
    "valid_through": { "type": ["string", "null"] },
    "revalidate_trigger": { "type": ["string", "null"] }
  }
}
