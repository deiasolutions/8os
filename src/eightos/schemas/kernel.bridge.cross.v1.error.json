{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel.bridge.cross.v1.error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "op", "status", "code", "message", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "op": { "const": "kernel.bridge.cross" },
    "status": { "const": "error" },
    "code": {
      "enum": [
        "SCHEMA_INVALID",
        "AUTHORIZATION_REQUIRED",
        "BRIDGE_UNREACHABLE",
        "EVENT_WRITE_FAILED_AFTER_CROSSING",
        "NOT_FOUND"
      ]
    },
    "message": { "type": "string" },
    "context": { "type": "object" }
  }
}
