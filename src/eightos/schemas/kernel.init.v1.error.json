{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel.init.v1.error",
  "title": "kernel.init error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "op", "status", "code", "message", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "op": { "const": "kernel.init" },
    "status": { "const": "error" },
    "code": {
      "type": "string",
      "enum": [
        "SCHEMA_INVALID",
        "ALREADY_EXISTS",
        "KERNEL_VERSION_MISMATCH"
      ]
    },
    "message": { "type": "string" },
    "context": { "type": "object" }
  }
}
