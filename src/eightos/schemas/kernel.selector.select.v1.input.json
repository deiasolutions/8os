    "domain": { "type": "string" },
    "demands": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "min_sigma": { "type": ["number", "null"] },
        "min_pi": { "type": ["number", "null"] },
        "min_alpha": { "type": ["number", "null"] },
        "min_rho": { "type": ["number", "null"] },
        "max_clock_ms": { "type": ["number", "null"] },
        "max_coin_usd": { "type": ["number", "null"] },
        "max_carbon_g": { "type": ["number", "null"] }
