{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel.authorize.v1.output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "op", "status", "data", "event_id", "indexes_updated"],
  "properties": {
    "schema_version": { "const": 1 },
    "op": { "const": "kernel.authorize" },
    "status": { "const": "ok" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_ir_id", "path", "valid_through"],
      "properties": {
        "authorization_ir_id": { "type": "string" },
        "path": { "type": "string" },
        "valid_through": { "type": ["string", "null"] }
      }
    },
    "event_id": { "type": "string" },
    "indexes_updated": { "type": "array", "items": { "type": "string" } }
  }
}
